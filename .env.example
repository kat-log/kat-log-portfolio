# Sentry エラートラッキング設定
# https://sentry.io でプロジェクトを作成し、DSNを取得してください

# クライアント・サーバー共通のDSN（必須）
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ソースマップアップロード用（CI/CD用、オプション）
SENTRY_ORG=your-org-name
SENTRY_PROJECT=your-project-name
SENTRY_AUTH_TOKEN=your-auth-token

# Google Analytics 4
# https://analytics.google.com で測定IDを取得してください
# NEXT_PUBLIC_GTM_ID を設定した場合は使われない（GA4 は GTM 側のタグで配信する）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager
# https://tagmanager.google.com でコンテナIDを取得してください
# 設定すると GA4 の直書きの代わりに GTM を読み込む
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
